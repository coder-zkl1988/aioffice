{
  "name": "@genoffice/web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-native GenOffice workspace",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress-assets.mjs && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\" --outfile=dist-server/server.mjs && node scripts/copy-runtime-assets.mjs",
    "serve": "node dist-server/server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@genoffice/ai-provider": "*",
    "@genoffice/ai-search": "*",
    "@genoffice/file-parse": "*",
    "@genoffice/docs": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/i18n": "*",
    "@genoffice/markdown": "*",
    "@genoffice/pdf": "*",
    "@genoffice/pdf-tools": "*",
    "@genoffice/project-store": "*",
    "@genoffice/sheets": "*",
    "@genoffice/slides": "*",
    "@genoffice/ui": "*",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-code-block": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/suggestion": "3.29.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^4.1.0"
  }
}
